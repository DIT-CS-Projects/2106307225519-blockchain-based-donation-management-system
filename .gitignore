# Dependencies
node_modules/
.pnp
.pnp.js

# Local tooling and generated audit artifacts
.cache/
.claude/
tmp/
client/.vercel/

# Environment variables
.env
.env.local
.env.*.local

# Build output
dist/
build/
*.tsbuildinfo

# ...except the report's build TOOLING (scripts, LaTeX header, reference.docx),
# which the generic build/ rule above accidentally swallows too since it's a
# source directory named "build", not build output.
!DOCUMENTATION/report/build/
!DOCUMENTATION/report/build/**

# Office/editor scratch files and local staging copies
DOCUMENTATION/report/out/~*
DOCUMENTATION/report/out/*.STAGED.docx

# Hardhat / blockchain
artifacts/
cache/
typechain/
typechain-types/

# Database
*.sqlite
*.sqlite3
*.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads (Multer)
uploads/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Coverage
coverage/
