# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database — Neon PostgreSQL (Decision 015)
# Paste your Neon connection string here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth secrets — generate strong random values for production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Initial administrator (used only by: npm run db:seed:admin)
# Public registration only creates donors; seed the first admin here.
# ADMIN_PASSWORD must meet the policy: 8+ chars, upper, lower, number, special.
# ADMIN_NAME=Platform Admin
# ADMIN_EMAIL=admin@changia.org
# ADMIN_PHONE=+255700000000
# ADMIN_PASSWORD=

# Payments (Stage 4). 'mock' runs a self-contained local checkout with no
# external credentials. 'clickpesa' and 'azampay' select real adapters.
# ClickPesa collects real money before KYC (capped), so it is the one that can
# demonstrate an actual payment today; AzamPay needs approved KYC first.
PAYMENT_PROVIDER=mock
PAYMENT_SESSION_TTL_MINUTES=30

# ClickPesa. Create an app under Settings > Developers to get the client id and
# api key, then subscribe to PAYMENT RECEIVED and PAYMENT FAILED webhooks.
# Real money moves immediately. Pre-KYC accounts are capped at TZS 100,000
# total across all activity and 100 API calls per day (token generation counts).
# Complete KYC in Settings > KYC to lift both limits.
# CLICKPESA_CLIENT_ID=
# CLICKPESA_API_KEY=
# Register the webhook as: https://<public-host>/api/payments/callback?key=<this-secret>
# ClickPesa sends no signature header, so this secret is what proves a webhook
# is genuinely ours. Generate an unguessable value.
# CLICKPESA_WEBHOOK_SECRET=
# Optional HMAC-SHA256 key, only if checksums are enabled on the account.
# CLICKPESA_CHECKSUM_KEY=
# One host serves every account; override only if ClickPesa says otherwise.
# CLICKPESA_BASE_URL=https://api.clickpesa.com

# AzamPay (Decision 009). Set PAYMENT_PROVIDER=azampay and fill all five values
# below to use the real gateway for mobile money; the bank rail stays on the mock.
# A selected real provider with missing values returns a clear checkout error.
# Get the
# credentials from the AzamPay developer portal (sandbox or production app).
# AZAMPAY_APP_NAME=
# AZAMPAY_CLIENT_ID=
# AZAMPAY_CLIENT_SECRET=
# AZAMPAY_API_KEY=
# Base hosts default to sandbox and need no override while testing.
# Sandbox:    https://authenticator-sandbox.azampay.co.tz  /  https://sandbox.azampay.co.tz
# Production: https://authenticator.azampay.co.tz          /  https://checkout.azampay.co.tz
# Going live moves real money and needs live credentials, issued only after
# AzamPay approves your business KYC (submitted from the sandbox portal).
# Set BOTH hosts together with the live credentials, never mixed with sandbox ones.
# AZAMPAY_AUTH_BASE_URL=https://authenticator.azampay.co.tz
# AZAMPAY_CHECKOUT_BASE_URL=https://checkout.azampay.co.tz
# Register your callback in the portal as: https://<public-host>/api/payments/callback?key=<this-secret>
# In local dev the public host is an ngrok/cloudflared tunnel to PORT 4000.
# AZAMPAY_CALLBACK_SECRET=

# Blockchain (Stage 5, Decision 010). 'local' talks to a Hardhat node you run
# with `npm run node` in contracts/ (deploy with `npm run deploy:local`);
# 'sepolia' is the later, real-network upgrade — set BLOCKCHAIN_RPC_URL to
# your Sepolia RPC endpoint (Alchemy/Infura) when you switch.
BLOCKCHAIN_NETWORK=local
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Backend wallet private key that records proofs. For local dev, use one of
# Hardhat's well-known, publicly-documented test account keys (never real funds).
BACKEND_WALLET_PRIVATE_KEY=
# Address printed by `npm run deploy:local` (or deploy:sepolia).
CONTRACT_ADDRESS=

# Email (Stage 6, Decision 017). 'console' logs instead of sending, no
# credentials needed; 'smtp' selects the real Nodemailer adapter below.
EMAIL_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Changia <no-reply@changia.org>

# Disbursement payouts. 'mock' completes instantly without moving funds.
# 'clickpesa' sends an approved payout from the ClickPesa merchant account
# balance to the beneficiary mobile number. It reuses the ClickPesa credentials
# above. The account must have enough balance for the payout plus its provider fee.
# Register payout status updates in ClickPesa and retain API status-query access;
# this application also safely polls status after an accepted payout.
DISBURSEMENT_PROVIDER=mock
