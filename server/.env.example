# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database — Neon PostgreSQL (Decision 015)
# Paste your Neon connection string here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth secrets — generate strong random values for production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Initial administrator (used only by: npm run db:seed:admin)
# Public registration only creates donors; seed the first admin here.
# ADMIN_PASSWORD must meet the policy: 8+ chars, upper, lower, number, special.
# ADMIN_NAME=Platform Admin
# ADMIN_EMAIL=admin@changia.org
# ADMIN_PHONE=+255700000000
# ADMIN_PASSWORD=

# Payments (Stage 4). 'mock' runs a self-contained local checkout with no
# external credentials; 'azampay' selects the real adapter once onboarded.
PAYMENT_PROVIDER=mock
PAYMENT_SESSION_TTL_MINUTES=30

# AzamPay (sandbox) — real adapter, added when onboarded (Decision 009)
# AZAMPAY_APP_NAME=
# AZAMPAY_CLIENT_ID=
# AZAMPAY_CLIENT_SECRET=
# AZAMPAY_BASE_URL=

# Blockchain (Stage 5, Decision 010). 'local' talks to a Hardhat node you run
# with `npm run node` in contracts/ (deploy with `npm run deploy:local`);
# 'sepolia' is the later, real-network upgrade — set BLOCKCHAIN_RPC_URL to
# your Sepolia RPC endpoint (Alchemy/Infura) when you switch.
BLOCKCHAIN_NETWORK=local
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Backend wallet private key that records proofs. For local dev, use one of
# Hardhat's well-known, publicly-documented test account keys (never real funds).
BACKEND_WALLET_PRIVATE_KEY=
# Address printed by `npm run deploy:local` (or deploy:sepolia).
CONTRACT_ADDRESS=

# Email (Stage 6, Decision 017). 'console' logs instead of sending, no
# credentials needed; 'smtp' selects the real Nodemailer adapter below.
EMAIL_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Changia <no-reply@changia.org>

# Disbursement payouts (Stage 6). 'mock' completes instantly, no credentials
# needed; 'azampay' selects the real adapter once onboarded.
DISBURSEMENT_PROVIDER=mock
