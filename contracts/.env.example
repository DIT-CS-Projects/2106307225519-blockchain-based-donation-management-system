# Blockchain deployment — Sepolia testnet (Decision 010)

# RPC endpoint (e.g. Alchemy or Infura Sepolia URL)
SEPOLIA_RPC_URL=

# Backend wallet private key that deploys and records proofs.
# Never commit a real key. Use a dedicated test wallet for Sepolia.
BACKEND_WALLET_PRIVATE_KEY=

# Optional: for contract verification on Etherscan
ETHERSCAN_API_KEY=
