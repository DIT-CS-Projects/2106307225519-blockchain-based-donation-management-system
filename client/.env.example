# Base URL of the backend API, including the /api prefix.
#
# Local development: leave unset. The Vite dev server proxies "/api" to the
# backend, so the default relative "/api" works.
#
# Production (Vercel): set this to the deployed Render backend, e.g.
#   VITE_API_BASE_URL=https://changia-api.onrender.com/api
VITE_API_BASE_URL=
